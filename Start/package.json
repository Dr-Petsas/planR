{
  "name": "planr-start",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && vite build",
    "build:sprache": "vite build -c vite.sprache.config.ts && node tools/sprache-nach-mas.mjs",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "nodemailer": "^6.10.1",
    "pdfjs-dist": "^6.4.299"
  }
}
